<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Brand -->
    <Color x:Key="PrimaryColor">#0078D4</Color>
    <Color x:Key="PrimaryHoverColor">#106EBE</Color>

    <!-- Background -->
    <Color x:Key="BackgroundColor">#FFFFFF</Color>
    <Color x:Key="SurfaceColor">#F5F5F5</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#202020</Color>
    <Color x:Key="TextSecondaryColor">#666666</Color>

    <!-- Status -->
    <Color x:Key="SuccessColor">#107C10</Color>
    <Color x:Key="WarningColor">#FFB900</Color>
    <Color x:Key="ErrorColor">#D13438</Color>

</ResourceDictionary>